# ─── 이 파일을 .env 로 복사한 뒤 값을 채우세요 ───
# cp .env.example .env   (PowerShell:  Copy-Item .env.example .env)

# Discord 봇 토큰 — Developer Portal > Bot > Reset Token 에서 발급
DISCORD_TOKEN=

# (선택) Discord 애플리케이션 ID — 시작 로그의 '봇 초대 링크' 에만 쓰입니다.
#   비우면 로그인한 봇 계정 ID 를 자동으로 씁니다(둘은 같은 값). 보통 비워두면 됩니다.
DISCORD_APPLICATION_ID=

# Claude 구독 인증 토큰 — 로컬에서  `claude setup-token`  실행 후 나온 값
CLAUDE_CODE_OAUTH_TOKEN=

# (선택) 사용할 모델. 비워두면 기본값 = sonnet.
#   예: sonnet , opus , haiku , claude-sonnet-5
CLAUDE_MODEL=

# (선택) workspace 파일 캐시 상한(MB). 비우면 1024(1GB).
#   첨부/생성 파일 누적이 상한을 넘으면 오래된 파일부터 삭제. 0 = 무제한.
WORKSPACE_CACHE_MB=

# (선택) 봇 전역 시스템 프롬프트(페르소나). 우선순위: 아래 인라인 > SYSTEM_PROMPT_FILE > system_prompt.md > 내장기본값
#   ※ 보안 규칙(경로 샌드박스·인젝션 방어)은 코드에서 항상 뒤에 덧붙어 강제됩니다.
SYSTEM_PROMPT=
# 프롬프트를 파일로 관리하려면 경로 지정 (비우면 프로젝트 루트의 system_prompt.md 사용)
SYSTEM_PROMPT_FILE=

# (선택) 링크 자동 미리보기(unfurl)를 허용할 호스트. 비우면 유튜브만 허용(그 외는 카드 안 붙음).
#   콤마 구분 목록 · none = 전부 차단 · * = 전부 허용(억제 안 함)
#   예: LINK_PREVIEW_HOSTS=youtube.com,youtu.be,github.com
LINK_PREVIEW_HOSTS=

# (선택) 게임 서버 온라인/오프라인 감시. 서버는 Discord 에서 /server add 로 등록.
#   GAME_POLL_SEC       감시 주기(초). 비우면 60, 최소 10.
#   GAME_FAIL_THRESHOLD 상태 전환 확정에 필요한 연속 관측 횟수(플래핑 방지). 비우면 2.
GAME_POLL_SEC=
GAME_FAIL_THRESHOLD=

# (선택) `/기억 학습`(채널 과거 대화를 읽어 참여자별 특징 정리)을 '서버 관리' 권한 없이도
#   실행할 수 있는 계정. 콤마 구분. 사용자 ID(숫자) 또는 사용자명.
#   ※ 사용자명은 본인이 바꿀 수 있으니 가능하면 숫자 ID 를 쓰세요.
#   예: MEMORY_LEARN_USERS=123456789012345678,example_user
MEMORY_LEARN_USERS=

# ⚠️  ANTHROPIC_API_KEY 는 절대 설정하지 마세요.
#     이 키가 있으면 SDK가 구독 대신 종량제 API로 과금됩니다.
#     (봇 시작 시 안전을 위해 자동으로 제거합니다.)
